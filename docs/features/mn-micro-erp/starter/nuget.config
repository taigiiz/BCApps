<?xml version="1.0" encoding="utf-8"?>
<!--
  MN Micro ERP - NuGet configuration (copy to repository root).
  Single source (nuget.org) + package source mapping: protects against dependency-confusion attacks
  if a private feed is ever added (map our own prefix, e.g. "Erp.*", to that feed explicitly).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
